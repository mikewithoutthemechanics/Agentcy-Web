# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─── Payments — Stripe (optional, for card payments) ───────────
# Get these from https://dashboard.stripe.com/test/apikeys
# Create a Subscription Product + Price first for each service offering if needed.
# For simplicity, we can have one Stripe price for a "Pro" tier across services, or per service.
VITE_STRIPE_SECRET_KEY=sk_test_...          # Only used if you create a backend endpoint
VITE_STRIPE_PRICE_PRO=price_...             # Example: R599/mo for a Pro tier
VITE_STRIPE_PRICE_ENTERPRISE=price_...      # Enterprise tier

# Success and cancel URLs for Stripe Checkout
VITE_STRIPE_SUCCESS_URL=https://agentcy.co.za/?checkout=success
VITE_STRIPE_CANCEL_URL=https://agentcy.co.za/?checkout=cancelled

# ─── PayFast Subscription URLs ───────────────────────────────
# Create subscription products in PayFast dashboard first
VITE_PAYFAST_PRO_URL=https://www.payfast.co.za/subscribe?id=your_pro_subscription_id
VITE_PAYFAST_ENTERPRISE_URL=https://www.payfast.co.za/subscribe?id=your_enterprise_subscription_id
